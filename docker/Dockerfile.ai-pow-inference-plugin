# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=ghcr.io/nockchain/nockchain-ai-pow-inference:latest
FROM ${BASE_IMAGE}

USER root
COPY crates/ai-pow-miner/vllm-plugin/pyproject.toml /tmp/nockchain-vllm-plugin/
COPY crates/ai-pow-miner/vllm-plugin/src /tmp/nockchain-vllm-plugin/src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-deps --reinstall --link-mode=copy \
      /tmp/nockchain-vllm-plugin \
    && rm -rf /tmp/nockchain-vllm-plugin
