# Copy this file outside the repository, replace every required value, and
# protect it as a secret-bearing production configuration.
MODEL_PATH=/workspace/models/Gemma-4-31B-it-pearl

# Nockchain production mining.
NOCKCHAIN_NODE_ADDR=http://node.internal:5555
MINING_PKH=replace-with-v1-mining-pkh
AI_POW_REQUIRE_MINING=1
NOCKCHAIN_GEMMA4_MINING_LAYER=0

# OpenAI-compatible API. A non-loopback listener requires an API key.
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_API_KEY=replace-with-random-secret
VLLM_SERVED_MODEL_NAME=gemma-4-31b-it-pearl

# Validated universal defaults. Tune only from benchmark evidence.
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.64
VLLM_ENFORCE_EAGER=1

# Leave unset to use every visible GPU. One H100 or RTX PRO 6000 uses 1;
# a two-device RTX 5090 deployment uses 2.
# VLLM_TENSOR_PARALLEL_SIZE=1

# Optional capacity controls.
# VLLM_MAX_NUM_SEQS=32
# VLLM_MAX_NUM_BATCHED_TOKENS=8192
