--- a/pyproject.toml
+++ b/pyproject.toml
@@ -7,15 +7,21 @@
 [[tool.uv.index]]
-name = "pytorch-cu130"
-url = "https://download.pytorch.org/whl/cu130"
+name = "pytorch-cu129"
+url = "https://download.pytorch.org/whl/cu129"
 explicit = true
 
-# vLLM 0.20.2+cu130 allows transformers 5.x (see wheel requires-dist); default resolution
+# vLLM 0.27.1+cu129 allows transformers 5.x (see wheel requires-dist); default resolution
 # stayed on 4.57.x. Gemma 4 checkpoints need transformers>=5.5 with model_type gemma4.
 [tool.uv]
 override-dependencies = [
-  "transformers>=5.5.1,<6",
+  "transformers==5.5.4",
-  "cuda-bindings>=13.0,<13.1",
+  "cuda-bindings>=12.9,<13",
-  "cuda-python>=13.0,<13.1",
+  "cuda-python>=12.9,<13",
+  "compressed-tensors==0.17.0",
+  "torch==2.13.0",
+  "torchaudio==2.11.0",
+  "torchvision==0.28.0",
+  "vllm==0.27.1",
+  "xgrammar==0.2.3",
 ]
 
 # Workspace sources - these apply globally to all members
@@ -31,10 +37,10 @@
 torch = [
-  { index = "pytorch-cu130", marker = "sys_platform == 'linux' or sys_platform == 'win32'" },
+  { index = "pytorch-cu129", marker = "sys_platform == 'linux' or sys_platform == 'win32'" },
 ]
 torchvision = [
-  { index = "pytorch-cu130", marker = "sys_platform == 'linux' or sys_platform == 'win32'" },
+  { index = "pytorch-cu129", marker = "sys_platform == 'linux' or sys_platform == 'win32'" },
 ]
 torchaudio = [
-  { index = "pytorch-cu130", marker = "sys_platform == 'linux' or sys_platform == 'win32'" },
+  { index = "pytorch-cu129", marker = "sys_platform == 'linux' or sys_platform == 'win32'" },
 ]
 
