: "${MODEL_REVISION:=f1dfba688ce6343b0433de57ca4dc0f3d1c5baa5}"

mkdir -p "${MODEL_PATH}"
hf download "${MODEL_ID}" --revision "${MODEL_REVISION}" --local-dir "${MODEL_PATH}"
