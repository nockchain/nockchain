load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//:lints/cargo_lint_sources.bzl", "cargo_lint_sources")

package(default_visibility = ["//visibility:public"])

cargo_lint_sources()

exports_files([
    "Cargo.toml",
    "README.md",
])

rust_library(
    name = "nockchain-mcp-lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    compile_data = ["src/rust_runtime.rs.template"],
    crate_name = "nockchain_mcp",
    edition = "2021",
    deps = [
        "//crates/nockapp",
        "//crates/nockapp-grpc-proto:nockapp-grpc",
        "//crates/nockchain-math",
        "//crates/nockchain-types",
        "//crates/nockvm/rust/nockvm",
    ] + all_crate_deps(),
)

rust_binary(
    name = "nockchain-mcp",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2021",
    deps = [
        ":nockchain-mcp-lib",
    ] + all_crate_deps(),
)

rust_test(
    name = "nockchain_mcp_unit_tests",
    crate = ":nockchain-mcp-lib",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
