load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_test_suite")
load("//:tools/bazel/lints/cargo_lint_sources.bzl", "cargo_lint_sources")

load("//tools/bazel/rust:defs.bzl", "rust_test_with_miri")

package(default_visibility = ["//visibility:public"])

cargo_lint_sources()

exports_files(["Cargo.toml"])

rust_library(
    name = "hoonc_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    compile_data = [
        "bootstrap/hoonc-prewarm.jam",
        "bootstrap/hoonc.jam",
        "//hoon/apps/hoonc:hoonc.hoon",
        "//crates/tools/hoonc/hoon:hoon-138.hoon",
    ],
    crate_name = "hoonc",
    edition = "2021",
    proc_macro_deps = [
        "//crates/lib/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        "//crates/lib/nockapp",
        "//crates/lib/nockvm/rust/nockvm",
        "//crates/lib/zkvm-jetpack",
    ] + all_crate_deps(),
)

rust_binary(
    name = "hoonc_bin",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [
        "bootstrap/hoonc-prewarm.jam",
        "bootstrap/hoonc.jam",
        "//hoon/apps/hoonc:hoonc.hoon",
        "//crates/tools/hoonc/hoon:hoon-138.hoon",
    ],
    crate_features = ["no_check_oom"],
    crate_name = "hoonc",
    crate_root = "src/main.rs",
    edition = "2021",
    proc_macro_deps = [
        "//crates/lib/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        ":hoonc_lib",
        "//crates/lib/nockapp",
        "//crates/lib/nockvm/rust/nockvm",
        "//crates/lib/zkvm-jetpack",
    ] + all_crate_deps(),
)

# Unit tests for hoonc library
rust_test(
    name = "hoonc_unit_tests",
    size = "small",
    crate = ":hoonc_lib",
    data = [
        "bootstrap/hoonc.jam",
        "bootstrap/hoonc-prewarm.jam",
        "//crates/tools/hoonc/hoon:hoon-138.hoon",
        "//hoon/apps/hoonc:hoonc.hoon",
    ],
    proc_macro_deps = [
        "//crates/lib/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        ":hoonc_lib",
        "//crates/lib/nockapp",
        "//crates/lib/nockvm/rust/nockvm",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test_with_miri(
    name = "hoonc_unit_tests_miri",
    size = "small",
    crate = ":hoonc_lib",
    data = [
        "bootstrap/hoonc.jam",
        "bootstrap/hoonc-prewarm.jam",
        "//crates/tools/hoonc/hoon:hoon-138.hoon",
        "//hoon/apps/hoonc:hoonc.hoon",
    ],
    proc_macro_deps = [
        "//crates/lib/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        ":hoonc_lib",
        "//crates/lib/nockapp",
        "//crates/lib/nockvm/rust/nockvm",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Integration tests for hoonc. Each file in tests/ is its own cargo integration
# test crate, so use rust_test_suite (one rust_test per file) — a single
# rust_test cannot resolve a crate root across multiple files. Matches the
# convention used in crates/bridge/bridge/BUILD.bazel etc.
rust_test_suite(
    name = "hoonc_integration_tests",
    size = "small",
    srcs = glob(
        ["tests/**/*.rs"],
        allow_empty = True,
    ),
    aliases = aliases(),
    data = [
        "bootstrap/hoonc.jam",
        "bootstrap/hoonc-prewarm.jam",
        "//crates/tools/hoonc/hoon:hoon-138.hoon",
        "//hoon/apps/hoonc:hoonc.hoon",
    ],
    edition = "2021",
    proc_macro_deps = [
        "//crates/lib/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        ":hoonc_lib",
        "//crates/lib/nockapp",
        "//crates/lib/nockvm/rust/nockvm",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

