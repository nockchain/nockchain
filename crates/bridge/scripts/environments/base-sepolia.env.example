# Real Base Sepolia Environment (unlimited blocks, real network)
# Usage: source environments/base-sepolia.env && ./run-bridge-only.sh
#
# Set the referenced BASE_SEPOLIA_* values in your shell before sourcing.

# Network identifier (used for deployment tracking)
export BRIDGE_ENV="base-sepolia"
export BASE_CHAIN_ID="84532"

# Tenderly Node RPC WebSocket URL.
export BASE_WS_URL="${BASE_SEPOLIA_WS_URL}"

# Public deployment identity. Keep addresses and signer identities in this
# reviewed manifest rather than duplicating them in shell configuration.
BASE_SEPOLIA_MANIFEST_PATH="$(dirname "${BASH_SOURCE[0]}")/../../e2e/environments/base-sepolia.json"
export INBOX_CONTRACT_ADDRESS="$(jq -er '.contracts.message_inbox.proxy.address' "$BASE_SEPOLIA_MANIFEST_PATH")"
export NOCK_CONTRACT_ADDRESS="$(jq -er '.contracts.nock.address' "$BASE_SEPOLIA_MANIFEST_PATH")"

# Bridge node addresses observed at the pinned manifest block.
export BRIDGE_NODE_0="$(jq -er '.pristine_state.bridge_nodes[0]' "$BASE_SEPOLIA_MANIFEST_PATH")"
export BRIDGE_NODE_1="$(jq -er '.pristine_state.bridge_nodes[1]' "$BASE_SEPOLIA_MANIFEST_PATH")"
export BRIDGE_NODE_2="$(jq -er '.pristine_state.bridge_nodes[2]' "$BASE_SEPOLIA_MANIFEST_PATH")"
export BRIDGE_NODE_3="$(jq -er '.pristine_state.bridge_nodes[3]' "$BASE_SEPOLIA_MANIFEST_PATH")"
export BRIDGE_NODE_4="$(jq -er '.pristine_state.bridge_nodes[4]' "$BASE_SEPOLIA_MANIFEST_PATH")"
unset BASE_SEPOLIA_MANIFEST_PATH
