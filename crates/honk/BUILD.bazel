load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//:lints/cargo_lint_sources.bzl", "cargo_lint_sources")

package(default_visibility = ["//visibility:public"])

cargo_lint_sources()

exports_files(["Cargo.toml"])

# honk library: the native Hoon compiler API (native/, pipeline, types).
rust_library(
    name = "honk_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    aliases = aliases(),
    crate_name = "honk",
    edition = "2021",
    proc_macro_deps = [
        "//crates/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        "//crates/hatch",
        "//crates/honc-cold-138",
        "//crates/hoonc:hoonc_lib",
        "//crates/nockapp",
        "//crates/nockvm/rust/nockvm",
        "//crates/zkvm-jetpack",
    ] + all_crate_deps(),
)

# The persistent build cache embeds a fingerprint of the compiler's own code
# in every cache key so that changing the compiler invalidates old caches
# (crates/honk/build.rs computes it under cargo). Bazel builds skip build.rs,
# so derive an equivalent here from the same inputs build.rs hashes: the
# compiler's sources plus the workspace Cargo.lock for third-party bumps.
# Hashing sources — never rlibs or other config-varying artifacts — keeps the
# fingerprint identical across configurations of one tree, so a cache primed
# with the target-config binary (`just bazel prime-honk-cache`) is readable
# by the exec-config honk that jam actions run. The value deliberately
# differs from cargo's fingerprint; cargo-built and Bazel-built binaries do
# not share a cache namespace.
genrule(
    name = "native_compiler_fingerprint_env",
    srcs = glob([
        "src/**/*.rs",
        "build.rs",
        "Cargo.toml",
    ]) + [
        "//:Cargo.lock",
        "//crates/hatch:fingerprint_srcs",
        "//crates/nockapp:fingerprint_srcs",
        "//crates/nockvm/rust/nockvm:fingerprint_srcs",
    ],
    outs = ["native_compiler_fingerprint.env"],
    cmd = "if command -v sha256sum >/dev/null 2>&1; then hash_tool='sha256sum'; " +
          "else hash_tool='shasum -a 256'; fi; " +
          "printf 'HONK_NATIVE_COMPILER_FINGERPRINT=bazel-%s\\n' " +
          "\"$$(cat $(SRCS) | $$hash_tool | cut -d' ' -f1)\" > $@",
)

# honk binary: the CLI. It embeds the hoonc-built hoon-138 prelude
# (formula+type), the canonical $octs type, and the hoon-138 source via
# include_bytes!(env!(...)), and stamps the cache-namespace fingerprint via
# env!(...). The crate's build.rs only sets those env vars; under Bazel we
# replicate that with rustc_env + compile_data + rustc_env_files (same idiom
# as crates/kernels/*), so no cargo_build_script is needed.
rust_binary(
    name = "honk",
    srcs = ["src/bin/honk.rs"],
    aliases = aliases(),
    compile_data = [
        "//hoon/common:hoon.hoon",
        "assets/honc-type-138.jam",
        "assets/honc-formula-138.jam",
        "assets/hoonc-octs-type-138.jam",
    ],
    crate_name = "honk",
    crate_root = "src/bin/honk.rs",
    edition = "2021",
    rustc_env = {
        "HONK_HOON_138_SOURCE": "$(location //hoon/common:hoon.hoon)",
        "HONK_HONC_TYPE_138_JAM": "$(location assets/honc-type-138.jam)",
        "HONK_HONC_FORMULA_138_JAM": "$(location assets/honc-formula-138.jam)",
        "HONK_HOONC_OCTS_TYPE_138_JAM": "$(location assets/hoonc-octs-type-138.jam)",
    },
    rustc_env_files = [":native_compiler_fingerprint_env"],
    proc_macro_deps = [
        "//crates/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        ":honk_lib",
        "//crates/hatch",
        "//crates/honc-cold-138",
        "//crates/hoonc:hoonc_lib",
        "//crates/nockapp",
        "//crates/nockvm/rust/nockvm",
        "//crates/zkvm-jetpack",
    ] + all_crate_deps(),
)

# kick binary: fires the build traps honk --arbitrary emits. It shares honk's
# evaluation environment through honk_lib (see crates/honk/src/eval.rs) and
# embeds none of the prelude assets, so it needs neither compile_data nor the
# cache-namespace fingerprint.
rust_binary(
    name = "kick",
    srcs = ["src/bin/kick.rs"],
    aliases = aliases(),
    crate_name = "kick",
    crate_root = "src/bin/kick.rs",
    edition = "2021",
    proc_macro_deps = [
        "//crates/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        ":honk_lib",
        "//crates/nockapp",
        "//crates/nockvm/rust/nockvm",
    ] + all_crate_deps(),
)
