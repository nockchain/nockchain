load("//:rules_hoon/defs.bzl", "honk_library", "hoon_library")

package(default_visibility = ["//visibility:public"])

# Arbitrary-build parity for the hoon-138 prelude, under Bazel: hoonc's
# arbitrary build of hoon-138 vs honk's NATIVE self-mint
# (HONK_NATIVE_PARITY=1, no embedded prelude), byte-compared with `cmp`.
# Both sides compile inside the sandbox from the same full hoon source tree
# (ALL_HOON_FILES below), so the artifacts are directly comparable with no
# waiver. This is the
# Bazel twin of `just honk-138-parity` (which builds the same pair locally).

ALL_HOON_FILES = [
    # An --arbitrary build scans the entire deps tree, and Bazel globs do not
    # cross package boundaries — `//hoon:files` alone omits every subpackage.
    # Both sides of the pairing MUST use this same list: the artifact embeds a
    # hash of the directory tree the compiler sees.
    "//hoon:files",
    "//hoon/apps/bridge:files",
    "//hoon/apps/dumbnet:files",
    "//hoon/apps/dumbnet/lib:files",
    "//hoon/apps/hoonc:files",
    "//hoon/apps/peek:files",
    "//hoon/apps/roswell:files",
    "//hoon/apps/wallet:files",
    "//hoon/apps/wallet/lib:files",
    "//hoon/common:files",
    "//hoon/common/markdown:files",
    "//hoon/common/stark:files",
    "//hoon/common/ztd:files",
    "//hoon/dat:files",
    "//hoon/jams:files",
    "//hoon/tests:files",
]

hoon_library(
    name = "hoon_138_ref",
    src = "//hoon/common:hoon.hoon",
    arbitrary = True,
    output = True,
    deps = ALL_HOON_FILES,
)

honk_library(
    name = "hoon_138_native",
    src = "//hoon/common:hoon.hoon",
    arbitrary = True,
    native_parity = True,
    deps = ALL_HOON_FILES,
)

sh_test(
    name = "hoon_138_arbitrary_parity_test",
    srcs = ["//assets/native:kernel_parity_test.sh"],
    size = "small",
    args = [
        "$(rootpath :hoon_138_ref)",
        "$(rootpath :hoon_138_native)",
    ],
    data = [
        ":hoon_138_native",
        ":hoon_138_ref",
    ],
)

# End-to-end byte parity for the minimized correctness regressions consolidated
# by the Honk bug-fix stack. Both compilers see the same empty dependency tree
# and the same workspace-relative source path, so `cmp` is an exact oracle
# without directory-hash or source-spot waivers.
CORRECTNESS_PARITY_FIXTURES = [
    ("empty_core", "correctness/empty-core.hoon"),
    ("non_ascii_cord", "correctness/non-ascii-cord.hoon"),
    ("wide_tisfas", "correctness/wide-tisfas.hoon"),
    ("wide_tuple_62", "axis-overflow/wide-tuple-62.hoon"),
    ("wide_tuple_63", "axis-overflow/wide-tuple-63.hoon"),
    ("wide_tuple_64", "axis-overflow/wide-tuple-64.hoon"),
]

# Import-header pairings. Unlike the empty-deps fixtures above, each entry
# imports real dependency leaves, so both compilers must agree on how the
# header is read and resolved, on the entry and library spots after it, and
# on how each dependency's trap is built (a /dat leaf is evaluated at build
# time). Both sides receive the same dependency leaves and dependency root.
#
# wild-import: the second imported core must remain searchable when its mold
# appears in a gate signature.
# import-syntax: every header form hoonc's +pile-rule accepts, including
# comments inside and between directives, list continuations, /* leaves
# under any mark and a /# data file.
IMPORT_PARITY_FIXTURES = {
    "wild_import": [
        "sur/first.hoon",
        "sur/second.hoon",
    ],
    "import_syntax": [
        "dat/konst.hoon",
        "dat/note.jam",
        "lib/alpha.hoon",
        "lib/beta.hoon",
        "lib/gamma.hoon",
        "sur/types.hoon",
    ],
}

[
    hoon_library(
        name = "{}_ref".format(name),
        src = "correctness/{}/entry.hoon".format(name.replace("_", "-")),
        arbitrary = True,
        deps_dir = "crates/honk/test-assets/correctness/{}".format(name.replace("_", "-")),
        output = True,
        deps = [
            "correctness/{}/{}".format(name.replace("_", "-"), dep)
            for dep in deps
        ],
    )
    for name, deps in IMPORT_PARITY_FIXTURES.items()
]

[
    honk_library(
        name = "{}_native".format(name),
        src = "correctness/{}/entry.hoon".format(name.replace("_", "-")),
        arbitrary = True,
        deps_dir = "crates/honk/test-assets/correctness/{}".format(name.replace("_", "-")),
        deps = [
            "correctness/{}/{}".format(name.replace("_", "-"), dep)
            for dep in deps
        ],
    )
    for name, deps in IMPORT_PARITY_FIXTURES.items()
]

[
    sh_test(
        name = "{}_parity_test".format(name),
        size = "small",
        srcs = ["//assets/native:kernel_parity_test.sh"],
        args = [
            "$(rootpath :{}_ref)".format(name),
            "$(rootpath :{}_native)".format(name),
        ],
        data = [
            ":{}_native".format(name),
            ":{}_ref".format(name),
        ],
    )
    for name in IMPORT_PARITY_FIXTURES
]

test_suite(
    name = "import_parity_test",
    tests = ["{}_parity_test".format(name) for name in IMPORT_PARITY_FIXTURES],
)

[
    hoon_library(
        name = "{}_ref".format(name),
        src = src,
        arbitrary = True,
        output = True,
        deps_dir = "_empty_honk_correctness_deps",
    )
    for name, src in CORRECTNESS_PARITY_FIXTURES
]

[
    honk_library(
        name = "{}_native".format(name),
        src = src,
        arbitrary = True,
        deps_dir = "_empty_honk_correctness_deps",
    )
    for name, src in CORRECTNESS_PARITY_FIXTURES
]

[
    sh_test(
        name = "{}_parity_test".format(name),
        size = "small",
        srcs = ["//assets/native:kernel_parity_test.sh"],
        args = [
            "$(rootpath :{}_ref)".format(name),
            "$(rootpath :{}_native)".format(name),
        ],
        data = [
            ":{}_ref".format(name),
            ":{}_native".format(name),
        ],
    )
    for name, _ in CORRECTNESS_PARITY_FIXTURES
]

test_suite(
    name = "correctness_regression_parity_test",
    tests = [
        "{}_parity_test".format(name)
        for name, _ in CORRECTNESS_PARITY_FIXTURES
    ] + [
        ":forked_softed_constraints_batch_parity_test",
        ":forked_softed_constraints_parity_test",
    ] + [
        "{}_parity_test".format(name)
        for name in IMPORT_PARITY_FIXTURES
    ],
)

# A changed /dat/softed-constraints.hoon must be compiled for its current
# contents rather than replaced by Honk's pinned canonical value. Honk
# deliberately delegates this semantic special case to hoonc; this pairing
# exercises that end-to-end fallback and compares the resulting artifact.
hoon_library(
    name = "forked_softed_constraints_ref",
    src = "softed-fallback/common/entry.hoon",
    arbitrary = True,
    output = True,
    deps = ["softed-fallback/dat/softed-constraints.hoon"],
    deps_dir = "crates/honk/test-assets/softed-fallback",
)

honk_library(
    name = "forked_softed_constraints_native",
    src = "softed-fallback/common/entry.hoon",
    arbitrary = True,
    deps = ["softed-fallback/dat/softed-constraints.hoon"],
    deps_dir = "crates/honk/test-assets/softed-fallback",
)

sh_test(
    name = "forked_softed_constraints_parity_test",
    size = "small",
    srcs = ["//assets/native:kernel_parity_test.sh"],
    args = [
        "$(rootpath :forked_softed_constraints_ref)",
        "$(rootpath :forked_softed_constraints_native)",
    ],
    data = [
        ":forked_softed_constraints_ref",
        ":forked_softed_constraints_native",
    ],
)

sh_test(
    name = "forked_softed_constraints_batch_parity_test",
    size = "small",
    srcs = ["softed-fallback/batch_parity_test.sh"],
    args = [
        "$(rootpath //crates/honk:honk)",
        "$(rootpath //crates/hoonc:hoonc_bin)",
        "$(rootpath //hoon/common:hoon.hoon)",
        "$(rootpath :softed-fallback/common/entry.hoon)",
        "$(rootpath :correctness/empty-core.hoon)",
    ],
    data = [
        ":correctness/empty-core.hoon",
        ":softed-fallback/common/entry.hoon",
        ":softed-fallback/dat/softed-constraints.hoon",
        "//crates/honk:honk",
        "//crates/hoonc:hoonc_bin",
        "//hoon/common:hoon.hoon",
    ],
)

# Uncached compile benchmark for the hoon-138 arbitrary build: times hoonc's
# arbitrary build vs honk's native self-mint (HONK_NATIVE_PARITY=1) from cold
# state at TEST TIME (outside Bazel's action cache) and reports a comparison.
# Manual — invoke explicitly:
#   bazel test --test_output=streamed //crates/honk/test-assets:hoon_138_compile_bench
#   bazel run //crates/honk/test-assets:hoon_138_compile_bench
# NOTE: the honk self-mint peaks ~14GB RSS.
sh_test(
    name = "hoon_138_compile_bench",
    timeout = "eternal",
    srcs = ["//assets/native:compile_bench.sh"],
    args = [
        "hoon-138",
        "arbitrary",
        "$(rootpath //crates/hoonc:hoonc_bin)",
        "$(rootpath //crates/honk:honk)",
        "$(rootpath //hoon/common:hoon.hoon)",
        "hoon",
    ],
    data = [
        "//crates/honk:honk",
        "//crates/hoonc:hoonc_bin",
        "//hoon/common:hoon.hoon",
    ] + ALL_HOON_FILES,
    tags = [
        "benchmark",
        "manual",
    ],
)
