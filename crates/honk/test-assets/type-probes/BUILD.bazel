        for name in COMPILER_FIXTURES
    ],
)

# Rejection-parity probes (reject/): each is ill-typed on purpose and must
# be REJECTED by BOTH compilers. These run at TEST time (both binaries in
# runfiles) because a build-rule action that is supposed to fail cannot be
# expressed as a hoon_jam/honk_jam build. Verdict = artifact absence.
# Coverage-targeted via cargo-tarpaulin against honk's ut error branches
# (mint-nice/vain/lost, find/find-fork, fish-core/loop, fire-dry,
# mull, redo-match, payload-block, ...); the same corpus runs in-process
# as crates/honk/tests/compiler_reject.rs so the branches count toward
# coverage. rest_loop_alias is special-cased twice: it is sh-level only
# (both compilers currently reject it by native stack overflow, which would
# abort an in-process test), and its test is tagged manual / kept out of the
# suites — how long the overflow takes to hit the guard page is platform-
# dependent, and on Linux CI runners it exceeds the small-test timeout.
# Run it locally with:
#   bazel test //crates/honk/test-assets/type-probes:reject_rest_loop_alias_test
REJECTION_PROBES = [
    "core_cast_arms",
    "door_sample_nest",
    "edit_arm_tack",
    "edit_nest_fail",
    "edit_unknown_limb",
    "find_fail_face_blocked",
    "find_fail_wing",
    "fish_core",
    "fish_loop",
    "fork_edit_synthetic",
    "fork_wing_missing",
    "lead_sample_edit",
    "mint_lost_case",
    "mint_vain_case",
    "mint_vain_wtcl",
    "mull_wet_body",
    "nest_fail_cast",
    "nest_fail_sample",
    "redo_fork_ambiguous",
    "redo_shape_mismatch",
    "rest_loop_alias",
    "skin_shape_mismatch",
    "test_not_flag",
    "tissig_empty",
    "wet_slag_tail",
]

# The divergent-bunt probe is intentionally native-only. Canonical hoonc also
# fails to produce an artifact, but does so through runaway evaluation rather
# than a bounded rejection, making it unsuitable for the ordinary
# both-compilers rejection suite. This test pins honk's stronger requirement:
# terminate promptly, report an error, and write no artifact.
sh_test(
    name = "reject_divergent_bunt_native_test",
    size = "small",
    srcs = ["native_rejection_test.sh"],
    args = [
        "$(rootpath //crates/honk:honk)",
        "$(rootpath //hoon/common:hoon.hoon)",
        "$(rootpath reject/divergent_bunt.hoon)",
    ],
    data = [
        "reject/divergent_bunt.hoon",
        "//crates/honk:honk",
        "//hoon/common:hoon.hoon",
    ],
)

[
    sh_test(
        name = "reject_{}_test".format(name),
        size = "small",
        srcs = ["rejection_test.sh"],
        args = [
            "$(rootpath //crates/hoonc:hoonc_bin)",
            "$(rootpath //crates/honk:honk)",
            "$(rootpath //hoon/common:hoon.hoon)",
            "$(rootpath reject/{}.hoon)".format(name),
        ],
        data = [
            "reject/{}.hoon".format(name),
            "//crates/honk:honk",
            "//crates/hoonc:hoonc_bin",
            "//hoon/common:hoon.hoon",
        ],
        tags = ["manual"] if name == "rest_loop_alias" else [],
    )
    for name in REJECTION_PROBES
]

test_suite(
    name = "rejection_parity_test",
    tests = [":reject_divergent_bunt_native_test"] + [
        "reject_{}_test".format(name)
        for name in REJECTION_PROBES
        # explicitly listed suite members override the manual tag, so the
        # stack-overflow probe must also be left out of the suite
        if name != "rest_loop_alias"
    ],
)

test_suite(
    name = "all_parity_test",
    tests = [
        ":type_probe_parity_test",
        ":fixture_parity_test",
        ":rejection_parity_test",
    ],
)
