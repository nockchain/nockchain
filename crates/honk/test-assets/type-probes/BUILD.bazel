# (probe name, entry label) for both corpora.
ALL_PAIRINGS = [
    (name, "{}.hoon".format(name))
    for name in TYPE_PROBES
] + [
    ("fixture_{}".format(name), "//hoon/tests:hoon-compiler/{}.hoon".format(name))
    for name in COMPILER_FIXTURES
]

[
    hoon_library(
        name = "{}_ref".format(name),
        src = src,
        arbitrary = True,
        output = True,
        deps_dir = "_empty_hoon_deps",
    )
    for name, src in ALL_PAIRINGS
]

[
    honk_library(
        name = "{}_native".format(name),
        src = src,
        arbitrary = True,
        deps_dir = "_empty_hoon_deps",
    )
    for name, src in ALL_PAIRINGS
]

[
    sh_test(
        name = "{}_parity_test".format(name),
        size = "small",
        srcs = ["//assets/native:kernel_parity_test.sh"],
        args = [
            "$(rootpath :{}_ref)".format(name),
            "$(rootpath :{}_native)".format(name),
        ],
        data = [
            ":{}_ref".format(name),
            ":{}_native".format(name),
        ],
    )
    for name, _ in ALL_PAIRINGS
]

test_suite(
    name = "type_probe_parity_test",
    tests = ["{}_parity_test".format(name) for name in TYPE_PROBES],
)

test_suite(
    name = "fixture_parity_test",
    tests = [
        "fixture_{}_parity_test".format(name)
        for name in COMPILER_FIXTURES
    ],
)

test_suite(
    name = "all_parity_test",
    tests = [
        ":type_probe_parity_test",
        ":fixture_parity_test",
    ],
)
