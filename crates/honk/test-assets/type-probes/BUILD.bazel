load("//:rules_hoon/defs.bzl", "honk_library", "hoon_library")

package(default_visibility = ["//visibility:public"])

# Type-checking parity pairings: each self-contained .hoon entry is compiled
# by BOTH hoonc (reference) and honk (native), --arbitrary with an explicitly
# empty deps dir, and the two jams must be byte-identical (`cmp`, no waiver).
# Empty deps make these pairings cheap (~1-2s per side): the entries import
# nothing, so both compilers see the same (empty) tree and identical
# sandbox-relative entry paths — the artifact embeds both.
#
# hoonc's exit code is NOT a build verdict (it exits 0 on "build failed,
# skipping write"), so acceptance is judged by artifact existence: a build
# failure on either side fails the pairing at the missing-input step.

# Curated probes (this package): each pins inferred types via !> across a
# distinct region of the type system (refinement, forks, wet gates, variance,
# molds, wings, hints, casts, auras, stdlib doors, skins, aliases).
