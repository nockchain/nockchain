load("//:rules_hoon/defs.bzl", "honk_library", "hoon_library")

package(default_visibility = ["//visibility:public"])

# Scratch pairings for suspected hoonc/honk divergences. Every `*.hoon` here is
# compiled by both compilers exactly like the curated type probes (--arbitrary,
# empty deps) and strictly compared. Probes that turn out to pin real behavior
# move to the curated list in ../BUILD.bazel.
LAB = [f[:-len(".hoon")] for f in glob(["*.hoon"])]

[
    hoon_library(
        name = "{}_ref".format(name),
        src = "{}.hoon".format(name),
        arbitrary = True,
        output = True,
        deps_dir = "_empty_hoon_deps",
    )
    for name in LAB
]

[
    honk_library(
        name = "{}_native".format(name),
        src = "{}.hoon".format(name),
        arbitrary = True,
        deps_dir = "_empty_hoon_deps",
    )
    for name in LAB
]

[
    sh_test(
        name = "{}_parity_test".format(name),
        size = "small",
        # Some lab probes pin known divergences; keep them out of `//...`.
        tags = ["manual"],
        srcs = ["//assets/native:kernel_parity_test.sh"],
        args = [
            "$(rootpath :{}_ref)".format(name),
            "$(rootpath :{}_native)".format(name),
        ],
        data = [
            ":{}_ref".format(name),
            ":{}_native".format(name),
        ],
    )
    for name in LAB
]
