::  c3: gain_cell_skin / lose_cell_skin through ?#(cell-skin wing) under ?: (mod.rs ~9837, ~10129):
::  noun, atom, cell, fork, hint and hold refs; ^ versus specific head/tail skins; void heads.
::  (Faced sub-refs under a nested cell skin and core refs are in divergent/.)
|%
+$  duo  [@ @]
++  main
  |=  [a=* b=@ c=$@(@ [p=@ q=@]) d=(list @) e=[@ @] u=duo w=$@(@ [* *])]
  :*  !>(?:(?#(^ a) a a))
      !>(?:(?#([@ @] a) a a))
      !>(?:(?#([%5 %6] a) a a))
      !>(?:(?#(^ b) !! b))
      !>(?:(?#([@ @] b) !! b))
      !>(?:(?#(^ c) c c))
      !>(?:(?#([@ @] w) w w))
      !>(?:(?#([^ @] w) w w))
      !>(?:(?#(^ d) d d))
      !>(?:(?#(^ t.+.d) d d))
      !>(?:(?#(^ u) u !!))
      !>(?:(?#([@ @] e) e !!))
      !>(?:(?#([^ @] e) !! e))
  ==
--
