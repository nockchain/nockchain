::  p1: hatch open() arms reached through honk's mint fallback: %sgts
::  (~2193), %mcgl (~2329), %brkt without a %$ chapter (~1934); plus
::  chum_to_nounexpr's vendor/product form (~2719) under ~/.
|%
++  main
  |=  a=@
  =/  bind  |=(m=mold |=([b=@ f=$-(@ @)] (f b)))
  :*  !>(~=(a +(a)))
      !>(;<(x=@ bind a +(x)))
      !>(~/(%foo:bar.1 |=(b=@ b)))
      !>(~%(%baz:qux..2 +7 ~ |=(b=@ b)))
    ::
      !>  |^  foo
          +|  %chap
          ++  foo  +(a)
          --
  ==
