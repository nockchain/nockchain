::  c2: ^~ (blow_ktsg) runs musk over literal .* formulas: each nock op's
::  stop paths (bad shapes, stopped subformulas, bad opcodes), op 4 carry
::  through u64 overflow and multi-byte atoms, op 9 on constant cores whose
::  mack fails, op 11 static and dynamic hints (musk_araw_uncached ~6055-6335).
|%
++  main
  |=  s=@
  :*  ^~(.*(0 5))
      ^~([.*(0 5) 1])
      ^~([1 .*(0 5)])
      ^~(.*(0 [18.446.744.073.709.551.616 0]))
      ^~(.*(0 [0 [1 2]]))
      ^~(.*(0 [2 5]))
      ^~(.*(0 [2 [2 5] [1 [1 7]]]))
      ^~(.*(0 [4 1 [1 2]]))
      ^~(+(18.446.744.073.709.551.615))
      ^~(+(18.446.744.073.709.551.616))
      ^~(+(0xffff.ffff.ffff.ffff.ffff))
      ^~(+(0x1.ffff.ffff.ffff.ffff.ffff.ffff.ffff.ffff))
      ^~(.*(0 [5 1]))
      ^~(.*(0 [6 1]))
      ^~(.*(0 [6 [1 0] 5]))
      ^~(.*(0 [6 [1 2] [1 3] [1 4]]))
      ^~(.*(0 [6 [1 1] [1 3] [1 4]]))
      ^~(.*(0 [7 1]))
      ^~(.*(0 [7 [0 0] [1 5]]))
      ^~(.*(0 [8 1]))
      ^~(.*(0 [8 [0 0] [1 5]]))
      ^~(.*(0 [9 1]))
      ^~(.*(0 [9 [1 2] [0 1]]))
      ^~(.*(0 [9 2 [0 0]]))
      ^~(.*([1 2] [9 7 [0 1]]))
      ^~(.*([[0 0] 5] [9 2 [0 1]]))
      ^~(.*(0 [10 1]))
      ^~(.*(0 [10 5 [0 1]]))
      ^~(.*(0 [10 [[1 2] [1 3]] [0 1]]))
      ^~(.*(0 [10 [2 [1 3]] [0 0]]))
      ^~(.*([1 2] [10 [2 [0 0]] [0 1]]))
      ^~(.*([1 2] [10 [0 [1 3]] [0 1]]))
      ^~(.*([1 2] [10 [1 [1 3]] [0 1]]))
      ^~(.*(0 [11 1]))
      ^~(.*(0 [11 %foo [1 5]]))
      ^~(.*(0 [11 [%foo [0 0]] [1 5]]))
      ^~(.*(0 [11 [%foo [1 6]] [1 5]]))
      ^~(.*(0 [12 [1 5] [1 6]]))
      ^~(~>(%foo 5))
  ==
--
