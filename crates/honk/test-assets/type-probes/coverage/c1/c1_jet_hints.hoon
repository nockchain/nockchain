::  c1: ~/ jet hints with every chum shape (lower_sigfas/lower_sigcen, mod.rs
::  ~3405-3446; Sig64 write_chum ~881 StdKel and VenProKel arms), and a ~%
::  with named hooks (lower_sigcen's tyre loop).
|%
++  main
  |=  a=@
  :*  (lef a)
      (std a)
      (vpk a)
      (vpv a)
      (hok a)
  ==
++  lef  ~/  %lef  |=(b=@ b)
++  std  ~/  %std.138  |=(b=@ b)
++  vpk  ~/  %ven:pro.2  |=(b=@ b)
++  vpv  ~/  %ven:pro..3  |=(b=@ b)
++  hok
  ~%  %hok  ..hok
    ==
      %one  ..hok
      %two  ..lef
    ==
  |=(b=@ b)
--
