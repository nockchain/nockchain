::  ?@ refinement over a $@ union: the gained (atom) and lost (cell) branch
::  types both reach the artifact through !>'s burped vase type. Regression
::  shape for the ++dish `~|` divergence (frag-doc %hint in the fork).
|%
++  main
  |=  w=wine
  [!>(?@(w w -.w)) !>(?@(w [w %atom] w))]
+$  wine
  $@  $?  %noun
          %void
          %wall
      ==
  $%  [%mato p=@tas]
      [%face p=@tas q=wine]
      [%bcwt p=(list wine)]
  ==
--
