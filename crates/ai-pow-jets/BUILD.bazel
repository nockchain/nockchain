load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:lints/cargo_lint_sources.bzl", "cargo_lint_sources")

package(default_visibility = ["//visibility:public"])

cargo_lint_sources()

exports_files(["Cargo.toml"])

rust_library(
    name = "ai-pow-jets",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "ai_pow_jets",
    edition = "2021",
    proc_macro_deps = [
        "//crates/nockvm/rust/nockvm_macros",
    ] + all_crate_deps(proc_macro = True),
    deps = [
        "//crates/ai-pow",
        "//crates/ai-pow-miner",
        "//crates/ai-pow-zk",
        "//crates/nockvm/rust/nockvm",
    ] + all_crate_deps(),
)
