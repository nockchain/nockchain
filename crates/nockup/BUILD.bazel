load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//:lints/cargo_lint_sources.bzl", "cargo_lint_sources")

package(default_visibility = ["//visibility:public"])

cargo_lint_sources()

exports_files([
    "Cargo.toml",
    "templates/basic/Cargo.toml",
    "templates/grpc/Cargo.toml",
    "templates/http-server/Cargo.toml",
    "templates/http-static/Cargo.toml",
    "templates/repl/Cargo.toml",
])

# Cargo's build.rs sets FULL_VERSION from CARGO_PKG_VERSION. Derive both from
# the package manifest (or its inherited workspace version) for Bazel too.
genrule(
    name = "package_version_env",
    srcs = ["Cargo.toml", "//:Cargo.toml"],
    outs = ["package_version.env"],
    cmd = "version=$$(sed -nE 's/^version[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\\1/p' $(location Cargo.toml) | head -n 1); " +
          "if [ -z \"$$version\" ] && grep -Eq '^version[.]workspace[[:space:]]*=[[:space:]]*true' $(location Cargo.toml); then " +
          "version=$$(sed -n '/\\[workspace.package\\]/,/\\[/p' $(location //:Cargo.toml) | " +
          "sed -nE 's/^version[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\\1/p' | head -n 1); " +
          "fi; " +
          "test -n \"$$version\"; " +
          "printf 'FULL_VERSION=%s\\nCARGO_PKG_VERSION=%s\\n' \"$$version\" \"$$version\" > $@",
)

# Library target for nockup
rust_library(
    name = "nockup_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_name = "nockup",
    crate_root = "src/lib.rs",
    data = glob([
        "templates/**/*",
    ]),
    edition = "2021",
    rustc_env_files = [":package_version_env"],
    deps = all_crate_deps(),
)

# Binary target for nockup CLI
rust_binary(
    name = "nockup",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_root = "src/main.rs",
    data = glob([
        "templates/**/*",
    ]),
    edition = "2021",
    rustc_env_files = [":package_version_env"],
    deps = all_crate_deps() + [":nockup_lib"],
)

# Unit tests - test the library crate
# TODO: Disabled, not maintaining it right now
rust_test(
    name = "nockup_unit_tests",
    size = "small",
    crate = ":nockup_lib",
    data = glob([
        "templates/**/*",
    ]),
    tags = ["manual"],
)
