# Root BUILD file for the nockchain workspace.
#
# Tracked as BUILD.open.bazel and renamed to BUILD.bazel by the export
# pipeline, so it only marks a Bazel package once this directory is the
# repository root.

package(default_visibility = ["//visibility:public"])

exports_files([
    ".bazelrc",
    ".bazelversion",
    "Cargo.toml",
    "Cargo.lock",
    "MODULE.bazel.lock",
    "Makefile",
    "rust-toolchain.toml",
    "rustfmt.toml",
])

# Pre-primed honk build cache, swept into honk_jam sandboxes as ordinary
# inputs — the same glob trick that gave hoonc warm starts under Bazel:
# park compiler state where the input globs can see it. Empty (and the
# actions run cold) until primed with `just bazel prime-honk-cache`; the
# directory is gitignored. Cache state only affects compile speed, never
# artifact bytes — the strict parity gates hold with or without it.
filegroup(
    name = "honk_build_cache",
    srcs = glob(
        [".honk-cache/**"],
        allow_empty = True,
    ),
)

# Convenience aliases for the primary binaries.
alias(
    name = "nockchain",
    actual = "//crates/nockchain",
)

alias(
    name = "nockchain-wallet",
    actual = "//crates/nockchain-wallet",
)

alias(
    name = "hoonc",
    actual = "//crates/hoonc:hoonc_bin",
)

alias(
    name = "honkd",
    actual = "//crates/honk-grpc:honkd",
)

# All kernel jam files compiled from Hoon sources via rules_hoon.
alias(
    name = "kernels",
    actual = "//assets:kernels",
)
