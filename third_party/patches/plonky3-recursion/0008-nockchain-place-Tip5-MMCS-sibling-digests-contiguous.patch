From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tacryt-socryp <1377557+tacryt-socryp@users.noreply.github.com>
Date: Mon, 20 Jul 2026 15:46:05 -0400
Subject: [PATCH 08/17] nockchain: place Tip5 MMCS sibling digests contiguously

Tip5 recursive MMCS compression now lays the running digest and sibling digest into the first two digest-width chunks of the permutation state. The pre-sibling injection row uses digest width for both placement and exposed-output metadata, matching the native TruncatedPermutation<Tip5,2,5,16> shape and avoiding rate-width overrun.

diff --git a/circuit/src/ops/mmcs.rs b/circuit/src/ops/mmcs.rs
index 98a1cabd0ff29c2c50b6e65ae8bcf5cb0da37abd..6fbce54e877946cc52d3d4a275afa54b5ee8bf27 100644
--- a/circuit/src/ops/mmcs.rs
+++ b/circuit/src/ops/mmcs.rs
@@ -88,7 +88,6 @@ impl<F: Field> CircuitBuilder<F> {
         let permutation_config: PermConfig = permutation_config.into();
         let width_ext = permutation_config.width_ext();
         let digest_ext = permutation_config.digest_ext();
-        let rate_ext = permutation_config.rate_ext();
         let mut op_ids = Vec::with_capacity(openings_expr.len());
         let mut output = vec![None; width_ext];
         let zero = self.define_const(F::ZERO);
@@ -122,8 +121,8 @@ impl<F: Field> CircuitBuilder<F> {
 
             if !is_first && !row_digest.is_empty() {
                 let mut inputs = vec![None; width_ext];
-                for (j, &d) in row_digest.iter().take(rate_ext).enumerate() {
-                    inputs[rate_ext + j] = Some(d);
+                for (j, &d) in row_digest.iter().take(digest_ext).enumerate() {
+                    inputs[digest_ext + j] = Some(d);
                 }
                 let _ = self.add_perm(
                     permutation_config,
@@ -133,7 +132,7 @@ impl<F: Field> CircuitBuilder<F> {
                         mmcs_bit: Some(zero),
                         mmcs_bit2: None,
                         inputs,
-                        out_ctl: vec![false; rate_ext],
+                        out_ctl: vec![false; digest_ext],
                         return_all_outputs: false,
                         mmcs_index_sum: None,
                     },
