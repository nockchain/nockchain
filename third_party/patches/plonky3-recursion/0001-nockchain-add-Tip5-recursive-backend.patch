+    /// Enables the Tip5 permutation operation for base-field challenges.
+    pub fn enable_tip5_perm<Config, P>(&mut self, trace_generator: TraceGeneratorFn<F>, perm: P)
+    where
+        Config: crate::ops::Tip5Params,
