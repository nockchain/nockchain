+/// `((RC as u128) * 2^64) % p` — the per-(round,lane) constant the AIR
+/// embeds (exactly `permute`'s `r_cons`).
+pub const fn rc_precomp(rc_raw: u64) -> u64 {
+    (((rc_raw as u128) * R) % P) as u64
+}
