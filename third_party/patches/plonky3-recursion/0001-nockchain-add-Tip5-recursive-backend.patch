+#[inline]
+fn badd(a: u64, b: u64) -> u64 {
+    (((a as u128) + (b as u128)) % P) as u64
+}
+
+#[inline]
+fn bmul(a: u64, b: u64) -> u64 {
+    (((a as u128) * (b as u128)) % P) as u64
+}
