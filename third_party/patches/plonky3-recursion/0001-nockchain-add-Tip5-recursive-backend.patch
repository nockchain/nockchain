+    #[test]
+    fn native_equiv_kat() {
+        let k = parse_fixture();
+        let inputs: Vec<[u64; STATE_SIZE]> = k.vectors.iter().map(|(i, _)| *i).collect();
+        let trace = generate_trace_rows(&inputs);
+        let width = tip5_perm_air_width();
