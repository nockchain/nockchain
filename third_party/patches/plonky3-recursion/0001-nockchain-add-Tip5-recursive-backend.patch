+        // native ≡ in-circuit: IN cols == fixture in, final ROUT == fixture out
+        for (row, (inp, out)) in k.vectors.iter().enumerate() {
+            for lane in 0..STATE_SIZE {
+                assert_eq!(
+                    trace.values[row * width + lane],
