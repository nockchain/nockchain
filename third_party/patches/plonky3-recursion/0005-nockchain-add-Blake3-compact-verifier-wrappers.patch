+        };
+        let expected_quintic = EF::DIMENSION == 5 && EF::alu_is_quintic_trinomial();
+        if proof.ext_degree != EF::DIMENSION {
+            return Err(ProofMetadataError::ExtDegreeMismatch {
+                expected: EF::DIMENSION,
