# honk-built twins of the hoonc kernels in //assets. Outputs are named
# `<kernel>_native.jam` so they never collide with the untracked local
# `assets/native/<kernel>.jam` files written by `just honk-kernel-jams`.
[
    honk_library(
        name = "{}_native".format(kernel),
        src = KERNELS[kernel][0],
        deps = KERNELS[kernel][1],
        # Optional pre-primed incremental cache; empty until
        # `just bazel prime-honk-cache` populates .honk-cache/, and the
        # compile is simply cold when it is. See //:honk_build_cache.
        cache_state = "//:honk_build_cache",
    )
    for kernel in KERNELS
]

# All six honk-built kernels in one Bazel invocation — the parallel twin of
# //assets:kernels. The jam actions carry resource_set memory hints, so Bazel
# schedules as many concurrent kernel compiles as local RAM allows.
# `just bazel build-assets-honk` builds this and copies the jams into
# assets/<kernel>.jam (the paths the cargo-side kernel crates embed).
filegroup(
    name = "kernels",
    srcs = ["{}_native".format(kernel) for kernel in KERNELS],
)

# Strict byte-parity tests: `cmp` of the hoonc-built kernel against the
# honk-built twin, both compiled inside Bazel from identical dep trees.
# No dir-hash waiver — a PASS is byte-for-byte equality.
[
    sh_test(
        name = "{}_parity_test".format(kernel),
        size = "small",
        srcs = ["kernel_parity_test.sh"],
        args = [
            "$(rootpath //assets:{})".format(kernel),
            "$(rootpath :{}_native)".format(kernel),
        ],
        data = [
            ":{}_native".format(kernel),
            "//assets:{}".format(kernel),
        ],
    )
    for kernel in KERNELS
]

test_suite(
    name = "kernel_parity_test",
    tests = ["{}_parity_test".format(kernel) for kernel in KERNELS],
)

# Uncached compile benchmarks: time hoonc and honk compiling the same kernel
# from cold state (fresh data dirs, no reuse) and report a comparison. The
# compiles happen at TEST TIME, deliberately outside Bazel's action cache.
# Manual: never run by wildcards or CI — invoke explicitly, e.g.
#   bazel test --test_output=streamed //assets/native:dumb_compile_bench
#   bazel test --test_env=BENCH_ITERATIONS=3 --test_output=streamed ...
#   bazel run //assets/native:dumb_compile_bench
[
    sh_test(
        name = "{}_compile_bench".format(kernel),
        timeout = "eternal",
        srcs = ["compile_bench.sh"],
        args = [
            kernel,
            "kernel",
            "$(rootpath //crates/hoonc:hoonc_bin)",
            "$(rootpath //crates/honk:honk)",
            "$(rootpath {})".format(KERNELS[kernel][0]),
            "hoon",
        ],
        data = [
            KERNELS[kernel][0],
            "//crates/honk:honk",
            "//crates/hoonc:hoonc_bin",
        ] + KERNELS[kernel][1],
        tags = [
            "benchmark",
            "manual",
        ],
    )
    for kernel in KERNELS
]

test_suite(
    name = "compile_bench",
    tags = ["manual"],
    tests = ["{}_compile_bench".format(kernel) for kernel in KERNELS],
)
