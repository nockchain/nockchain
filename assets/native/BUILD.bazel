    "wal": (
        "//hoon/apps/wallet:wallet.hoon",
        [
            "//hoon/apps/bridge:types.hoon",
            "//hoon/apps/dumbnet:miner.hoon",
            "//hoon/apps/dumbnet/lib:asert.hoon",
            "//hoon/apps/dumbnet/lib:types.hoon",
            "//hoon/apps/wallet/lib:files",
            "//hoon/common:files",
            "//hoon/common/markdown:files",
            "//hoon/common/stark:files",
