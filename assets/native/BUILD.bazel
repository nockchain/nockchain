load("//:rules_hoon/defs.bzl", "honk_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "compile_bench.sh",
    "kernel_parity_test.sh",
])

# One entry per kernel: src + the hoon dependency tree it compiles against.
# Each dep list MUST match the //assets hoonc counterpart exactly: the
# artifact embeds a hash of the directory tree the compiler sees, so byte
# parity requires identical sandbox layouts on both sides of a pairing.
KERNELS = {
    "bridge": (
        "//hoon/apps/bridge:bridge.hoon",
        [
            "//hoon/apps/bridge:files",
            "//hoon/apps/dumbnet:files",
            "//hoon/apps/dumbnet/lib:files",
            "//hoon/apps/wallet/lib:files",
            "//hoon/common:files",
            "//hoon/common/markdown:files",
            "//hoon/common/stark:files",
            "//hoon/common/ztd:files",
            "//hoon/dat:files",
            "//hoon/jams:files",
        ],
    ),
    "dumb": (
        "//hoon/apps/dumbnet:outer.hoon",
        [
            "//hoon/apps/dumbnet:inner.hoon",
            "//hoon/apps/dumbnet:miner.hoon",
            "//hoon/apps/dumbnet/lib:files",
            "//hoon/common:files",
            "//hoon/common/stark:files",
            "//hoon/common/ztd:files",
            "//hoon/dat:files",
            "//hoon/jams:files",
        ],
    ),
    "miner": (
        "//hoon/apps/dumbnet:miner.hoon",
        [
            "//hoon/apps/dumbnet/lib:asert.hoon",
            "//hoon/common:files",
            "//hoon/common/stark:files",
            "//hoon/common/ztd:files",
            "//hoon/dat:files",
            "//hoon/jams:files",
        ],
    ),
    "peek": (
        "//hoon/apps/peek:peek.hoon",
        [
            "//hoon/common:files",
            "//hoon/common/stark:files",
            "//hoon/common/ztd:files",
            "//hoon/dat:files",
            "//hoon/jams:files",
        ],
    ),
    "roswell": (
        "//hoon/apps/roswell:roswell.hoon",
        [
            "//hoon/apps/bridge:files",
            "//hoon/apps/dumbnet:inner.hoon",
            "//hoon/apps/dumbnet:miner.hoon",
            "//hoon/apps/dumbnet:outer.hoon",
            "//hoon/apps/dumbnet/lib:files",
            "//hoon/apps/roswell:files",
            "//hoon/apps/wallet:wallet.hoon",
            "//hoon/apps/wallet/lib:files",
            "//hoon/common:files",
            "//hoon/common/markdown:files",
            "//hoon/common/stark:files",
            "//hoon/common/ztd:files",
            "//hoon/dat:files",
            "//hoon/jams:files",
            "//hoon/tests:files",
